{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soul.local/schemas/inference.schema.json",
  "title": "SoulInference",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "inference_id", "target", "statement_key", "evidence_ids", "evidence_band", "clinical_claim"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "inference_id": { "type": "string" },
    "target": { "type": "object" },
    "statement_key": { "type": "string" },
    "evidence_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "evidence_band": { "enum": ["weak", "moderate", "strong"] },
    "method": { "enum": ["user_stated", "rule", "statistical", "llm", "hybrid"] },
    "user_verdict": { "enum": ["unreviewed", "accepted", "corrected", "rejected"] },
    "clinical_claim": { "const": false },
    "falsifier": { "type": "string", "minLength": 8 }
  }
}
