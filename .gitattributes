# Keep the frozen contracts and source on LF even on Windows checkouts.
# Schema lock hashes now also ignore CRLF, but pinning checkout endings
# stops rustfmt/clippy and JSON parsers from fighting the platform.
* text=auto eol=lf
*.rs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.txt text eol=lf
*.lock text eol=lf
*.justfile text eol=lf
justfile text eol=lf
*.ps1 text eol=crlf
*.png binary
*.ico binary
*.exe binary
