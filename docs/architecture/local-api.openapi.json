  "components": {
    "schemas": {
      "BuiltinFixtureId": {
        "type": "string",
        "enum": [
          "basic"
        ]
      },
      "CallerTransport": {
        "type": "string",
        "enum": [
          "desktop",
          "http"
        ]
      },
      "EmptyRequest": {
        "type": "object",
        "description": "Strict empty JSON for operations whose full address is in the route.",
        "additionalProperties": false
      },
      "ImportConfirmRequest": {
        "type": "object",
        "description": "The operation ID is carried by the versioned route, never selected implicitly.",
        "required": [
          "preview_id"
        ],
        "properties": {
          "preview_id": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "MemoryDetailView": {
        "type": "object",
        "required": [
          "memory_id",
          "memory_type",
          "title",
          "summary",
          "third_party_content_present"
        ],
        "properties": {
          "memory_id": {
            "type": "string"
          },
          "memory_type": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "third_party_content_present": {
            "type": "boolean"
          },
          "title": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "MemoryEditRequest": {
        "type": "object",
        "properties": {
          "memory_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "summary": {
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      },
      "OperationKind": {
        "type": "string",
        "enum": [
          "import_prepare",
          "import_confirm",
          "import_discard",
          "scoped_draft",
          "scoped_propose",
          "scoped_confirm",
          "scoped_discard",
          "memory_edit",
          "forget_preview",
          "forget_confirm"
        ]
      },
      "PeoplePage": {
        "type": "object",
        "required": [
          "people",
          "offset",
          "limit",
          "total",
          "has_more",
          "third_party_data_is_local_only"
        ],
        "properties": {
          "has_more": {
            "type": "boolean"
          },
          "limit": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "offset": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "people": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PersonView"
            }
          },
          "third_party_data_is_local_only": {
            "type": "boolean"
          },
          "total": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "PeoplePageRequest": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "format": "int32",
            "default": 50,
            "maximum": 100,
            "minimum": 1
          },
          "offset": {
            "type": "integer",
            "format": "int32",
            "default": 0,
            "maximum": 1000000,
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "PersonView": {
        "type": "object",
        "required": [
          "contact_id",
          "is_you",
          "identifier_hint",
          "interaction_count",
          "tie_count",
          "forgotten"
        ],
        "properties": {
          "contact_id": {
            "type": "string"
          },
          "forgotten": {
            "type": "boolean"
          },
          "identifier_hint": {
            "type": "string"
          },
          "interaction_count": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "is_you": {
            "type": "boolean"
          },
          "last_contact_utc": {
            "type": [
              "string",
              "null"
            ]
          },
          "tie_count": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "ReadError": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ReadErrorCode"
          },
          "details": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ReadErrorDetail"
              }
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "ReadErrorCode": {
        "type": "string",
        "enum": [
          "invalid_request",
          "read_failed"
