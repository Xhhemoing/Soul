{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soul.local/schemas/_defs.schema.json",
  "$defs": {
    "uuid7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "timestamp": { "type": "string", "format": "date-time" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "evidenceBand": { "enum": ["weak", "moderate", "strong", "none"] },
    "sealedText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_key_id", "blob_id", "alg", "subject", "char_count"],
      "properties": {
        "content_key_id": { "$ref": "#/$defs/uuid7" },
        "blob_id": { "$ref": "#/$defs/uuid7" },
        "alg": { "const": "xchacha20poly1305-ietf" },
        "aad": { "type": "string" },
        "subject": { "enum": ["self", "third_party", "mixed"] },
        "char_count": { "type": "integer", "minimum": 0 },
        "placeholder": { "type": ["string", "null"] }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "derivation", "purposes", "retention", "egress"],
      "properties": {
        "subject": { "enum": ["self", "third_party", "mixed", "system"] },
        "derivation": { "enum": ["raw", "derived", "aggregate"] },
        "purposes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["soul_profile", "assistant_task", "graph", "memory", "research", "audit", "diagnostics"]
          }
        },
        "retention": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": { "enum": ["until_forgotten", "days", "session"] },
            "days": { "type": ["integer", "null"], "minimum": 1 }
          }
        },
        "egress": {
          "type": "object",
          "additionalProperties": false,
          "required": ["e0", "e1", "research_export"],
          "properties": {
            "e0": { "const": "deny" },
            "e1": { "enum": ["deny", "placeholder", "allow"] },
            "research_export": { "enum": ["deny", "hash", "bucket", "allow"] }
          }
        }
      }
    }
  }
}
