{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soul.local/schemas/evidence.schema.json",
  "title": "SoulEvidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_id", "kind", "subject", "source_refs", "strength"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "evidence_id": { "type": "string" },
    "kind": { "enum": ["message", "app_usage", "questionnaire", "user_statement", "user_correction", "aggregate"] },
    "subject": { "enum": ["self", "third_party", "mixed", "system"] },
    "source_refs": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "strength": { "enum": ["weak", "moderate", "strong"] },
    "method": { "enum": ["user_stated", "manual", "heuristic", "statistical", "llm"] },
    "exportable_to_research": { "type": "boolean", "default": false },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "derivation", "purposes", "retention", "egress"],
      "properties": {
        "subject": { "enum": ["self", "third_party", "mixed", "system"] },
        "derivation": { "enum": ["raw", "derived", "aggregate"] },
        "purposes": { "type": "array", "minItems": 1 },
        "retention": { "type": "object" },
        "egress": {
          "type": "object",
          "additionalProperties": false,
          "required": ["e0", "e1", "research_export"],
          "properties": {
            "e0": { "const": "deny" },
            "e1": { "enum": ["deny", "placeholder", "allow"] },
            "research_export": { "enum": ["deny", "hash", "bucket", "allow"] }
          }
        }
      }
    }
  }
}
