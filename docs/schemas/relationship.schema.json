{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soul.local/schemas/relationship.schema.json",
  "title": "SoulRelationship",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "relationship_id",
    "from_contact_id",
    "to_contact_id",
    "evidence_ids"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "relationship_id": { "$ref": "https://soul.local/schemas/_defs.schema.json#/$defs/uuid7" },
    "from_contact_id": { "$ref": "https://soul.local/schemas/_defs.schema.json#/$defs/uuid7" },
    "to_contact_id": { "$ref": "https://soul.local/schemas/_defs.schema.json#/$defs/uuid7" },
    "types": { "type": "array" },
    "tie_strength": { "type": "object" },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "https://soul.local/schemas/_defs.schema.json#/$defs/uuid7" }
    },
    "egress_scope": { "const": "local_only" }
  }
}
