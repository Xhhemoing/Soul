{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soul.local/schemas/relationship.schema.json",
  "title": "SoulRelationship",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "relationship_id",
    "from_contact_id",
    "to_contact_id",
    "evidence_ids"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "relationship_id": { "$ref": "https://soul.local/schemas/_defs.schema.json#/$defs/uuid7" },
    "from_contact_id": { "$ref": "https://soul.local/schemas/_defs.schema.json#/$defs/uuid7" },
    "to_contact_id": { "$ref": "https://soul.local/schemas/_defs.schema.json#/$defs/uuid7" },
    "types": { "type": "array" },
    "tie_strength": {
      "$comment": "T4D 的可复核面。band 之外的每个数字都必须是用户能自己数一遍的原始计数：没有分数、没有权重、没有百分位（DECISIONS D22）。此处 additionalProperties:false 就是该禁令的执行点。判档规则、常量与 as_of 纪律见 docs/algorithms/DECISION.md 第 3 节，本文件不复述阈值。",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "band": {
          "allOf": [
            { "$ref": "https://soul.local/schemas/_defs.schema.json#/$defs/evidenceBand" },
            { "enum": ["weak", "moderate", "strong"] }
          ]
        },
        "algorithm_id": {
          "$comment": "T4D 是 v0.1 发布形态；T4 只在 DECISION.md 第 5 节档内回退触发时才合法。枚举只有两个值，第三套判档规则不能靠新字符串偷渡进来。",
          "enum": ["T4D", "T4"]
        },
        "interaction_count": { "type": "integer", "minimum": 0 },
        "outgoing_count": { "type": "integer", "minimum": 0 },
        "incoming_count": { "type": "integer", "minimum": 0 },
        "direct_out_count": {
          "$comment": "一对一（venue 为私聊）且由本人发出。T4D 的三道门只读 direct_* 计数。",
          "type": "integer",
          "minimum": 0
        },
        "direct_in_count": { "type": "integer", "minimum": 0 },
        "group_out_count": {
          "$comment": "群聊行分列保留：参与展示与近因，不参与判档（DECISION.md 2.1 / 4.1）。",
          "type": "integer",
          "minimum": 0
        },
        "group_in_count": { "type": "integer", "minimum": 0 },
        "conversation_count": { "type": "integer", "minimum": 0 },
        "active_day_count": {
          "$comment": "任一场地的去重自然日（UTC）。",
          "type": "integer",
          "minimum": 0
        },
        "direct_active_day_count": {
          "$comment": "一对一的去重自然日（UTC），恒 ≤ active_day_count。Strong 的自然日门读这一个。",
          "type": "integer",
          "minimum": 0
        },
        "first_contact_utc": { "$ref": "https://soul.local/schemas/_defs.schema.json#/$defs/timestamp" },
        "last_contact_utc": {
          "$comment": "任一场地的最近一次往来。降档时钟与 A2 的「最近很久没有往来」句共读此字段，二者永不同屏矛盾。",
          "$ref": "https://soul.local/schemas/_defs.schema.json#/$defs/timestamp"
        },
        "last_direct_contact_utc": {
          "$comment": "最近一次一对一往来；从未一对一时为 null。只展示，不判档：T4D 只有一个近因时钟（DECISION.md 3、4.3；direct-only 时钟变体已作废）。可缺省，以容忍 Option 字段被跳过序列化。",
          "anyOf": [
            { "$ref": "https://soul.local/schemas/_defs.schema.json#/$defs/timestamp" },
            { "type": "null" }
          ]
        },
        "silent_days": {
          "$comment": "as_of 与 last_contact_utc 之间的整数 UTC 天数，向下取整，不小于 0。空观测为 0，不进时间运算。",
          "type": "integer",
          "minimum": 0
        },
        "as_of_utc": {
          "$comment": "as_of 纪律：一次 rebuild 全库一个值，由调用方传入。禁止 per-peer 取该 peer 自己的最大时间戳（会让休眠关系假 Strong）。judgement 一律不读墙钟，所以该值必须随边落库、可被复核。",
          "$ref": "https://soul.local/schemas/_defs.schema.json#/$defs/timestamp"
        },
        "machine_band": {
          "$comment": "机器档。D32：未锁边也写；重建边常为 Some。生效档另见 band / user_band。",
          "allOf": [
            { "$ref": "https://soul.local/schemas/_defs.schema.json#/$defs/evidenceBand" },
            { "enum": ["weak", "moderate", "strong"] }
          ]
        },
        "user_band": {
          "$comment": "用户锁定档。D32：locked ⟺ user_band 有值。未锁时省略或 null。",
          "anyOf": [
            {
              "allOf": [
                { "$ref": "https://soul.local/schemas/_defs.schema.json#/$defs/evidenceBand" },
                { "enum": ["weak", "moderate", "strong"] }
              ]
            },
            { "type": "null" }
          ]
        },
        "locked_by_user": {
          "$comment": "D32 / D48：用户纠正锁定。不进 algorithm_id 的条件必填，因为锁定是可选状态。",
          "type": "boolean"
        }
      },
      "dependentRequired": {
        "direct_out_count": ["algorithm_id"],
        "direct_in_count": ["algorithm_id"],
        "group_out_count": ["algorithm_id"],
        "group_in_count": ["algorithm_id"],
        "direct_active_day_count": ["algorithm_id"],
        "silent_days": ["algorithm_id"],
        "as_of_utc": ["algorithm_id"],
        "last_direct_contact_utc": ["algorithm_id"],
        "user_band": ["locked_by_user"]
      },
      "if": { "required": ["algorithm_id"] },
      "then": {
        "$comment": "吸收 T4D 之后不允许半迁移：一旦声明了判档算法，可复核面必须整套在场——基础计数、分列计数、一对一自然日、沉寂天数、as_of 与 band 缺一不可，否则 band 不可复核。此处不写 last_direct_contact_utc：它可为 null，允许实现跳过序列化。本层刻意不设无条件 required，未声明 algorithm_id 时保持 Goal 1 今天的宽松度（含空对象），收紧只发生在声明了算法之后。",
        "required": [
          "band",
          "interaction_count",
          "outgoing_count",
          "incoming_count",
          "conversation_count",
          "active_day_count",
          "first_contact_utc",
          "last_contact_utc",
          "direct_out_count",
          "direct_in_count",
          "group_out_count",
          "group_in_count",
          "direct_active_day_count",
          "silent_days",
          "as_of_utc"
        ]
      }
    },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "https://soul.local/schemas/_defs.schema.json#/$defs/uuid7" }
    },
    "egress_scope": { "const": "local_only" }
  }
}
