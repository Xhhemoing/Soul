{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soul.local/schemas/profile.schema.json",
  "title": "SoulProfile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "voice", "trait_axes", "clinical_claim"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "profile_id": { "$ref": "https://soul.local/schemas/_defs.schema.json#/$defs/uuid7" },
    "voice": { "type": "object" },
    "trait_axes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["axis_id", "position", "evidence_band", "clinical_claim"],
        "properties": {
          "axis_id": { "$ref": "https://soul.local/schemas/_defs.schema.json#/$defs/uuid7" },
          "label": { "type": "string" },
          "position": { "enum": ["leans_low", "mixed", "leans_high", "unknown"] },
          "evidence_band": {
            "$ref": "https://soul.local/schemas/_defs.schema.json#/$defs/evidenceBand"
          },
          "evidence_ids": {
            "type": "array",
            "items": { "$ref": "https://soul.local/schemas/_defs.schema.json#/$defs/uuid7" }
          },
          "locked_by_user": { "type": "boolean" },
          "clinical_claim": { "const": false }
        }
      }
    },
    "values": { "type": "array" },
    "boundaries": { "type": "array" },
    "clinical_claim": { "const": false }
  }
}
