{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soul.local/schemas/audit.schema.json",
  "title": "SoulAuditEntry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "seq",
    "entry_id",
    "ts",
    "prev_hash",
    "entry_hash",
    "action",
    "decision"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "seq": { "type": "integer", "minimum": 0 },
    "entry_id": { "$ref": "https://soul.local/schemas/_defs.schema.json#/$defs/uuid7" },
    "ts": { "$ref": "https://soul.local/schemas/_defs.schema.json#/$defs/timestamp" },
    "prev_hash": { "$ref": "https://soul.local/schemas/_defs.schema.json#/$defs/sha256" },
    "entry_hash": { "$ref": "https://soul.local/schemas/_defs.schema.json#/$defs/sha256" },
    "action": {
      "enum": [
        "consent.grant",
        "collect.start",
        "collect.stop",
        "import.commit",
        "inference.write",
        "profile.correct",
        "memory.write",
        "forget.execute",
        "draft.create",
        "egress.request",
        "file.plan",
        "hitl.deny",
        "capability.reject",
        "injection.blocked"
      ]
    },
    "decision": { "enum": ["allowed", "denied", "deferred", "n/a"] },
    "reason_code": {
      "oneOf": [{ "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" }, { "type": "null" }]
    },
    "subject_refs": {
      "type": "array",
      "items": { "$ref": "https://soul.local/schemas/_defs.schema.json#/$defs/uuid7" }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "items": { "type": "integer", "minimum": 0 },
        "bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "plan_hash": {
      "oneOf": [
        { "$ref": "https://soul.local/schemas/_defs.schema.json#/$defs/sha256" },
        { "type": "null" }
      ]
    },
    "capability_token_id": {
      "oneOf": [
        { "$ref": "https://soul.local/schemas/_defs.schema.json#/$defs/uuid7" },
        { "type": "null" }
      ]
    },
    "egress_class": { "enum": ["none", "E0", "E1", "L"] }
  }
}
