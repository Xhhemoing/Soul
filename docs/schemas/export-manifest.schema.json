{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soul.local/schemas/export-manifest.schema.json",
  "title": "SoulExportManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "export_kind",
    "third_party_rows",
    "written_to_disk",
    "redaction_profile",
    "rows"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "manifest_id": { "type": "string" },
    "export_kind": { "enum": ["research_preview", "self_full_export"] },
    "fields": {
      "type": "array",
      "items": {
        "enum": [
          "event_kind",
          "time_bucket_utc",
          "duration_bucket",
          "self_trait_axis",
          "self_trait_band",
          "aggregate_count"
        ]
      }
    },
    "rows": { "type": "array", "items": { "type": "object", "additionalProperties": false, "properties": {
      "event_kind": { "type": "string" },
      "time_bucket_utc": { "type": "string" },
      "duration_bucket": { "type": "string" },
      "self_trait_axis": { "type": "string" },
      "self_trait_band": { "enum": ["weak", "moderate", "strong"] },
      "aggregate_count": { "type": "integer", "minimum": 0 }
    } } },
    "third_party_rows": { "type": "integer", "const": 0 },
    "written_to_disk": { "type": "boolean" },
    "redaction_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["third_party_body"],
      "properties": {
        "third_party_body": { "const": "excluded" },
        "one_time_override_allowed": { "const": false }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "export_kind": { "const": "research_preview" } }, "required": ["export_kind"] },
      "then": { "properties": { "written_to_disk": { "const": false } } }
    }
  ]
}
