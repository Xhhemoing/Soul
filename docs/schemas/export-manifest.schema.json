{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soul.local/schemas/export-manifest.schema.json",
  "title": "SoulExportManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "export_kind", "third_party_rows", "written_to_disk"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "manifest_id": { "type": "string" },
    "export_kind": { "enum": ["research_preview", "self_full_export"] },
    "fields": { "type": "array" },
    "third_party_rows": { "type": "integer", "const": 0 },
    "written_to_disk": { "type": "boolean" },
    "redaction_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["third_party_body"],
      "properties": {
        "third_party_body": { "const": "excluded" },
        "one_time_override_allowed": { "const": false }
      }
    }
  }
}
